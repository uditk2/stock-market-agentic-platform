# Kotak Neo credentials.
# Without all five the app runs with no prices at all; there is no synthetic feed.
# Keep every value on its own line: an inline "# comment" after the value is
# read as part of the value by python-dotenv.

# Neo app or web: Invest tab -> Trade API card -> generate application
KOTAK_CONSUMER_KEY=

# Registered mobile, with country code, e.g. +919876543210
KOTAK_MOBILE_NUMBER=

# Unique Client Code, shown in your Neo profile
KOTAK_UCC=

# Your Neo MPIN. Optional: the Admin tab never stores this and asks for it at
# each login, because an MPIN beside the TOTP secret is the whole account in one
# place. Set it here only for a deployment that must log in unattended.
KOTAK_MPIN=

# Base32 secret from the one-time TOTP registration at
# https://www.kotaksecurities.com/platform/kotak-neo-trade-api/
# Kotak issues this when you scan the QR; it is not something this app can
# generate. Optional: without it the Admin tab asks for the six-digit code from
# your authenticator instead. Storing it only saves that typing.
KOTAK_TOTP_SECRET=

# Protects the Admin tab, which is where broker credentials are entered. The
# whole tab is behind it, reads included; leave it empty and the tab shows only
# an explanation of how to enable it. Nothing else in the app needs it.
LIVEGRAPH_ADMIN_PASSWORD=

# CLIProxyAPI: fronts your Claude Code / Codex subscriptions. If you have no
# proxy yet, `docker compose --profile local-proxy up --build` starts one from
# cliproxy/config.yaml; see the README.
CLIPROXY_BASE_URL=http://localhost:8317/v1
CLIPROXY_API_KEY=
LIVEGRAPH_AGENT_MODEL=claude-sonnet-5
LIVEGRAPH_CODER_MODEL=claude-opus-5
